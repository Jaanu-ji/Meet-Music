        {
          "name": "Get Artist by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/artists/{{artistId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "artists", "{{artistId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Hire",
      "item": [
        {
          "name": "Search Artists",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hire/search?genre=Pop&location=Los+Angeles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hire", "search"],
              "query": [
                {
                  "key": "genre",
                  "value": "Pop"
                },
                {
                  "key": "location",
                  "value": "Los Angeles"
                }
              ]
            }
          }
        },
        {
          "name": "Book Artist",
